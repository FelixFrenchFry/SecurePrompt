{
    "name": "secureprompt",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "license": "UNLICENSED",
    "scripts": {
        "dev": "pnpm --filter @secureprompt/extension dev",
        "build": "pnpm --filter @secureprompt/extension build",
        "zip": "pnpm --filter @secureprompt/extension zip",
        "typecheck": "pnpm -r --parallel typecheck",
        "check:secrets": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-secrets.ps1",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "11.0.8",
            "onFail": "download"
        }
    },
    "devDependencies": {
        "prettier": "^3.8.3"
    }
}
