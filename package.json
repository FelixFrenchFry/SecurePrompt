{
    "name": "secureprompt",
    "version": "0.1.0",
    "description": "Censor private information in your prompts before sending them to AI chatbots. Sensitive text is detected and replaced locally on your device.",
    "private": true,
    "scripts": {
        "dev": "wxt",
        "build": "tsc --noEmit && wxt build",
        "check:secrets": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-secrets.ps1",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "typecheck": "tsc --noEmit",
        "zip": "wxt zip",
        "postinstall": "wxt prepare"
    },
    "license": "UNLICENSED",
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "11.0.8",
            "onFail": "download"
        }
    },
    "type": "module",
    "dependencies": {
        "awesome-phonenumber": "^7.8.0",
        "card-validator": "^10.0.4",
        "german-tax-id-validator": "^1.0.7",
        "ibantools": "^4.5.4",
        "ip-regex": "^5.0.0",
        "ipaddr.js": "^2.4.0",
        "jsvat": "^2.5.4",
        "libphonenumber-js": "^1.12.43",
        "linkifyjs": "^4.3.2",
        "lucide-react": "^1.14.0",
        "react": "^19.2.6",
        "react-dom": "^19.2.6",
        "tldts": "^7.0.30"
    },
    "devDependencies": {
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@wxt-dev/module-react": "^1.2.2",
        "prettier": "^3.8.3",
        "typescript": "^6.0.3",
        "wxt": "^0.20.25"
    }
}
