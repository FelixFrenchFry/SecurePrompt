{
    "name": "@secureprompt/extension",
    "version": "0.1.0",
    "description": "Censor private information in your prompts before sending them to AI chatbots. Sensitive text is detected and replaced locally on your device.",
    "private": true,
    "type": "module",
    "license": "MIT",
    "scripts": {
        "dev": "wxt",
        "build": "tsc --noEmit && wxt build",
        "typecheck": "tsc --noEmit",
        "zip": "wxt zip",
        "postinstall": "wxt prepare"
    },
    "dependencies": {
        "@primer/octicons-react": "^19.41.0",
        "@primer/primitives": "^11.10.0",
        "@secureprompt/core": "workspace:*",
        "@secureprompt/model-runtime": "workspace:*",
        "react": "^19.2.6",
        "react-dom": "^19.2.6"
    },
    "devDependencies": {
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@wxt-dev/module-react": "^1.2.2",
        "typescript": "^7.0.2",
        "wxt": "^0.20.25"
    }
}
